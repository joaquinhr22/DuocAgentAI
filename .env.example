# Copiar este archivo como .env y completar. El .env NO se sube al repo.

# Groq: https://console.groq.com/keys
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.1-8b-instant

# PostgreSQL con pgvector.
# Con docker compose no hay que cambiar nada (el servicio se llama "db").
# Si usan una BD en la nube (Supabase, Neon, etc.) pegar aca su connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/duoc_agent

# Opcionales
PROMPT_VERSION=few_shot
USAR_RERANKER=true
TOP_K_FINAL=5
