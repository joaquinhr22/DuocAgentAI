{
  "uid": "duoc-agente",
  "title": "Orientador Duoc · Observabilidad",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {"id": 1, "type": "stat", "title": "Turnos totales", "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "sum(agente_respuestas_total)"}]},
    {"id": 2, "type": "stat", "title": "Errores totales", "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
     "targets": [{"refId": "A", "expr": "sum(agente_errores_total) or vector(0)"}]},
    {"id": 3, "type": "stat", "title": "Latencia p95 (últimos 15 min)", "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
     "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(agente_latencia_segundos_bucket[15m])))"}]},
    {"id": 4, "type": "piechart", "title": "Aprobaciones (human-in-the-loop)", "gridPos": {"x": 18, "y": 0, "w": 6, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "sum by (resultado) (agente_aprobaciones_total)", "legendFormat": "{{resultado}}"}]},
    {"id": 5, "type": "timeseries", "title": "Turnos por minuto, por tipo de tarea", "gridPos": {"x": 0, "y": 4, "w": 9, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "sum by (tipo) (rate(agente_respuestas_total[5m])) * 60", "legendFormat": "{{tipo}}"}]},
    {"id": 6, "type": "timeseries", "title": "Latencia p50 / p95", "gridPos": {"x": 9, "y": 4, "w": 9, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
     "targets": [
       {"refId": "A", "expr": "histogram_quantile(0.5, sum by (le) (rate(agente_latencia_segundos_bucket[5m])))", "legendFormat": "p50"},
       {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(agente_latencia_segundos_bucket[5m])))", "legendFormat": "p95"}]},
    {"id": 7, "type": "bargauge", "title": "Uso de herramientas", "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "options": {"orientation": "horizontal", "displayMode": "gradient"},
     "targets": [{"refId": "A", "expr": "sum by (herramienta) (agente_herramientas_total)", "legendFormat": "{{herramienta}}"}]},
    {"id": 8, "type": "timeseries", "title": "Errores por minuto", "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "sum(rate(agente_errores_total[5m])) * 60 or vector(0)", "legendFormat": "errores"}]}
  ]
}
